import numpy as np
import random
import torch
import torch.nn as nn
import torch.optim as optim

# DQN Network
class DQN(nn.Module):
    def __init__(self, state_size, action_size):
        super().__init__()
        self.fc = nn.Sequential(
            nn.Linear(state_size, 64),
            nn.ReLU(),
            nn.Linear(64, 64),
            nn.ReLU(),
            nn.Linear(64, action_size)
        )

    def forward(self, x):
        return self.fc(x)

# Parameters
state_size = 4
action_size = 3
gamma = 0.99

# Online and Target Networks
online = DQN(state_size, action_size)
target = DQN(state_size, action_size)
target.load_state_dict(online.state_dict())

optimizer = optim.Adam(online.parameters(), lr=0.001)

# Sample finance data
state = torch.rand(1, state_size)
next_state = torch.rand(1, state_size)
action = torch.tensor([1])
reward = torch.tensor([10.0])
done = torch.tensor([0.0])

# Current Q-value
q_value = online(state)[0, action]

# DDQN: Online network selects action
best_action = online(next_state).argmax(1)

# Target network evaluates action
next_q = target(next_state)[0, best_action]

# DDQN target
target_q = reward + gamma * next_q * (1 - done)

# Loss and training
loss = (q_value - target_q.detach()) ** 2

optimizer.zero_grad()
loss.backward()
optimizer.step()

# Update target network
target.load_state_dict(online.state_dict())

print("DDQN training completed")
print("Loss:", loss.item())
